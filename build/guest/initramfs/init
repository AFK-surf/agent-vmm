#!/bin/busybox sh
set -eu

export PATH=/bin:/sbin
mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys

for module in virtio_pci virtio_mmio virtio_rng virtio_blk virtio_net vmw_vsock_virtio_transport squashfs; do
  modprobe "$module"
done

root=
for serial in /sys/block/vd*/serial; do
  if [ "$(tr -d '\000\n' <"$serial")" = AGENT_ROOT ]; then
    root=/dev/$(basename "$(dirname "$serial")")
    break
  fi
done
test -n "$root"
mkdir -p /newroot
mount -t squashfs -o ro "$root" /newroot
mount --move /dev /newroot/dev
mount --move /proc /newroot/proc
mount --move /sys /newroot/sys
exec switch_root /newroot /sbin/init
