<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.afk-surf.agent-vmm-connect</string>
  <key>ProgramArguments</key>
  <array>
    <string>__APP__/Contents/Helpers/agent-vmm-connect</string>
    <string>--remote-compute-socket</string>
    <string>__HOME__/Library/Application Support/AgentVMM/remote-compute.sock</string>
    <string>--trust-socket</string>
    <string>__HOME__/Library/Application Support/AgentVMM/trust.sock</string>
    <string>--trust-capability-file</string>
    <string>__HOME__/Library/Application Support/AgentVMM/connector-trust.cap</string>
    <string>--service-tunnel-socket</string>
    <string>__HOME__/Library/Application Support/AgentVMM/service-tunnel.sock</string>
    <string>--mesh-control-socket</string>
    <string>__HOME__/Library/Application Support/AgentVMM/mesh-control.sock</string>
    <string>--data-worker</string>
    <string>__APP__/Contents/Helpers/agent-vmm-data</string>
    <string>--data-worker-socket</string>
    <string>__HOME__/Library/Application Support/AgentVMM/data-worker.sock</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ProcessType</key><string>Background</string>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/AgentVMM/connect.stdout.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/AgentVMM/connect.stderr.log</string>
</dict>
</plist>
