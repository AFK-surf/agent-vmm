[Unit]
Description=Agent VMM Host
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User={{.User}}
Group={{.Group}}
WorkingDirectory={{.State}}
ExecStart={{.Current}}/agent-vmm host --bundle {{.Current}}/guest --instance {{.State}}/instance --serial-log {{.State}}/logs/serial.log --operator-socket {{.State}}/operator.sock --remote-compute-socket {{.State}}/remote-compute.sock --database {{.State}}/host.sqlite --session-directory {{.State}}/sessions --data-worker {{.Current}}/agent-vmm-data --disable-personal-mesh-pairing
# Host stop or restart preserves the independent VMM child.
# Update and uninstall stop the VM explicitly before stopping the Host.
KillMode=process
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
StandardOutput=append:{{.ServiceLogs}}/host.stdout.log
StandardError=append:{{.ServiceLogs}}/host.stderr.log

[Install]
WantedBy=multi-user.target
