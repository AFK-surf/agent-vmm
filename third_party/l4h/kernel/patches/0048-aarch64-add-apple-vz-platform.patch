+BOOT_CODE static void clear_boot_memory(pptr_t pptr, word_t bits)
+{
+    word_t step_bits = MIN(bits, (word_t)seL4_PageBits);
+    word_t step = BIT(step_bits);
+    word_t len = BIT(bits);
+
+#ifdef CONFIG_PLAT_APPLE_VZ
+    /* Only the 128 MiB loader boot window [0x9000_0000, 0x9800_0000) and the
+     * 2 MiB-aligned neighborhood around ui_p_reg / dtb_p_reg can hold dirty
+     * pages or cache lines from boot; untouched pages outside them stay
+     * zero-backed in XNU MAP_ANON without faulting the full guest RAM. */
+    paddr_t reg_start = addrFromPPtr((void *)pptr);
+    paddr_t reg_end = reg_start + len;
+    paddr_t w0_start = (paddr_t)0x90000000ULL;
+    paddr_t w0_end = (paddr_t)0x98000000ULL;
+    paddr_t w1_start = apple_vz_boot_dirty_hi_start;
+    paddr_t w1_end = apple_vz_boot_dirty_hi_end;
+
+    if (w1_start < w1_end && w1_start <= w0_end && w1_end >= w0_start) {
+        w0_start = MIN(w0_start, w1_start);
+        w0_end = MAX(w0_end, w1_end);
+        w1_start = w1_end;
+    }
+
+    paddr_t dirty_start = MAX(reg_start, w0_start);
+    paddr_t dirty_end = MIN(reg_end, w0_end);
+    if (dirty_start < dirty_end) {
+        clear_boot_memory_range(pptr + (dirty_start - reg_start),
+                                dirty_end - dirty_start, step, step_bits);
+    }
+    if (w1_start < w1_end) {
+        dirty_start = MAX(reg_start, w1_start);
+        dirty_end = MIN(reg_end, w1_end);
+        if (dirty_start < dirty_end) {
+            clear_boot_memory_range(pptr + (dirty_start - reg_start),
+                                    dirty_end - dirty_start, step, step_bits);
+        }
+    }
+#else
+    clear_boot_memory_range(pptr, len, step, step_bits);
+#endif
+}
