                         index, reserved,
                         it_v_reg, extra_bi_size_bits);
 }
@@ -321,7 +490,7 @@ BOOT_CODE static bool_t try_init_kernel_secondary_core(void)
     return true;
 }
 
-BOOT_CODE static void release_secondary_cpus(void)
+BOOT_CODE static void release_secondary_cpus(word_t target_cpus)
 {
     /* release the cpus at the same time */
     assert(0 == node_boot_lock); /* Sanity check for a proper lock state. */
@@ -345,7 +514,7 @@ BOOT_CODE static void release_secondary_cpus(void)
 #endif
 
     /* Wait until all the secondary cores are done initialising */
-    while (ksNumCPUs != CONFIG_MAX_NUM_NODES) {
+    while (ksNumCPUs != target_cpus) {
 #ifdef ENABLE_SMP_CLOCK_SYNC_TEST_ON_BOOT
         NODE_STATE(ksCurTime) = getCurrentTime();
 #endif
@@ -460,7 +629,39 @@ static BOOT_CODE bool_t try_init_kernel(
         return false;
     }
 
-    if (!arch_init_freemem(ui_p_reg, dtb_p_reg, it_v_reg, extra_bi_size_bits)) {
+    word_t num_cpus = CONFIG_MAX_NUM_NODES;
+    const p_region_t *mem_regs = avail_p_regs;
+    word_t num_mem_regs = ARRAY_SIZE(avail_p_regs);
+#ifdef CONFIG_PLAT_APPLE_VZ
+    BOOT_BSS static p_region_t fdt_mem_regs[MAX_NUM_FREEMEM_REG];
+    if (dtb_size > 0) {
+        word_t fdt_n_regs = 0;
+        word_t fdt_n_cpus = 0;
+        apple_vz_parse_fdt((const void *)paddr_to_pptr(dtb_phys_addr), dtb_size,
+                           fdt_mem_regs, MAX_NUM_FREEMEM_REG, &fdt_n_regs, &fdt_n_cpus);
+        if (fdt_n_regs > 0) {
+            mem_regs = fdt_mem_regs;
+            num_mem_regs = fdt_n_regs;
+        }
+        if (fdt_n_cpus > 0) {
+            num_cpus = fdt_n_cpus > CONFIG_MAX_NUM_NODES ? CONFIG_MAX_NUM_NODES : fdt_n_cpus;
+        }
+    }
+#endif
+#ifdef CONFIG_PLAT_APPLE_VZ
+    {
+        paddr_t hi_lo = ui_p_reg.start;
+        if (dtb_p_reg.start != 0 && dtb_p_reg.start < hi_lo) {
+            hi_lo = dtb_p_reg.start;
+        }
+        paddr_t hi_hi = MAX(ui_p_reg.end, dtb_p_reg.end);
+        apple_vz_boot_dirty_hi_start = ROUND_DOWN(
+            hi_lo > BIT(seL4_LargePageBits) ? hi_lo - BIT(seL4_LargePageBits) : 0,
+            seL4_LargePageBits);
+        apple_vz_boot_dirty_hi_end = ROUND_UP(hi_hi, seL4_LargePageBits);
+    }
+#endif
+    if (!arch_init_freemem(ui_p_reg, dtb_p_reg, it_v_reg, extra_bi_size_bits, num_mem_regs, mem_regs)) {
         printf("ERROR: free memory management initialization failed\n");
         return false;
     }
@@ -486,7 +687,7 @@ static BOOT_CODE bool_t try_init_kernel(
     init_smc(root_cnode_cap);
 #endif
 
-    populate_bi_frame(0, CONFIG_MAX_NUM_NODES, ipcbuf_vptr, extra_bi_size);
+    populate_bi_frame(0, num_cpus, ipcbuf_vptr, extra_bi_size);
 
     /* put DTB in the bootinfo block, if present. */
     seL4_BootInfoHeader header;
@@ -568,7 +769,7 @@ static BOOT_CODE bool_t try_init_kernel(
     }
 
 #ifdef CONFIG_KERNEL_MCS
-    init_sched_control(root_cnode_cap, CONFIG_MAX_NUM_NODES);
+    init_sched_control(root_cnode_cap, num_cpus);
 #endif
 
