diff --git a/src/plat/apple-vz/apple-vz.dts b/src/plat/apple-vz/apple-vz.dts
new file mode 100644
index 0000000..9157f3a
--- /dev/null
+++ b/src/plat/apple-vz/apple-vz.dts
@@ -0,0 +1,41 @@
+/dts-v1/;
+
+/ {
+	#address-cells = <0x2>;
+	#size-cells = <0x2>;
+	interrupt-parent = <&gic>;
+
+	chosen {
+		seL4,elfloader-devices = &{/psci}, &{/timer};
+		seL4,kernel-devices = &{/intc@10000000}, &{/timer};
+	};
+
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x0 0x80000000 0x0 0x80000000>;
+	};
+
+	gic: intc@10000000 {
+		compatible = "arm,gic-v3";
+		#address-cells = <0x2>;
+		#size-cells = <0x2>;
+		#interrupt-cells = <0x3>;
+		interrupt-controller;
+		reg = <0x0 0x10000000 0x0 0x10000
+		       0x0 0x10010000 0x0 0x1e0000>;
+	};
+
+	psci {
+		compatible = "arm,psci-0.2";
+		method = "hvc";
+	};
+
+	timer {
+		compatible = "arm,armv8-timer";
+		always-on;
+		interrupts = <0x1 0xd 0x3f08
+		              0x1 0xe 0x3f08
+		              0x1 0xb 0x3f08
+		              0x1 0xa 0x3f08>;
+	};
+};
