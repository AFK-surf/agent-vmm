@@ -109,8 +268,18 @@ BOOT_CODE static bool_t arch_init_freemem(p_region_t ui_p_reg,
         reserve_region(ui_p_reg);
     }
 
-    /* avail_p_regs comes from the auto-generated code */
-    return init_freemem(ARRAY_SIZE(avail_p_regs), avail_p_regs,
+    /* Keep reserved[] sorted by start address (e.g. when live FDT is placed above ui_p_reg). */
