+static BOOT_CODE uint32_t fdt_be32(const uint8_t *p)
+{
+    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) |
+           ((uint32_t)p[2] << 8) | (uint32_t)p[3];
+}
+
+static BOOT_CODE uint64_t fdt_be64(const uint8_t *p)
+{
+    return ((uint64_t)fdt_be32(p) << 32) | (uint64_t)fdt_be32(p + 4);
+}
+
+static BOOT_CODE bool_t fdt_str_eq(const char *a, const char *b)
+{
+    while (*a && *b && *a == *b) {
+        a++;
+        b++;
+    }
+    return *a == 0 && *b == 0;
+}
+
+static BOOT_CODE bool_t fdt_str_prefix(const char *s, const char *prefix)
+{
+    while (*prefix) {
+        if (*s++ != *prefix++) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static BOOT_CODE void apple_vz_parse_fdt(
+    const void *dtb_ptr,
+    word_t dtb_size,
+    p_region_t *mem_regs,
+    word_t max_regs,
+    word_t *out_num_regs,
+    word_t *out_num_cpus
+)
+{
+    const uint8_t *b = (const uint8_t *)dtb_ptr;
+    *out_num_regs = 0;
+    *out_num_cpus = 0;
+    if (dtb_size < 40 || fdt_be32(b) != 0xd00dfeedU) {
+        return;
+    }
+    uint32_t totalsize = fdt_be32(b + 4);
+    uint32_t off_struct = fdt_be32(b + 8);
+    uint32_t off_strings = fdt_be32(b + 12);
+    if (totalsize > dtb_size || off_struct >= totalsize || off_strings >= totalsize) {
+        return;
+    }
+    uint32_t pos = off_struct;
+    int depth = 0;
+    bool_t in_cpus = false;
+    bool_t in_memory = false;
+    while (pos + 4 <= totalsize) {
+        uint32_t tok = fdt_be32(b + pos);
+        pos += 4;
+        if (tok == 1) { /* FDT_BEGIN_NODE */
+            const char *name = (const char *)(b + pos);
+            uint32_t end = pos;
+            while (end < totalsize && b[end] != 0) {
+                end++;
+            }
+            if (end >= totalsize) {
+                break;
+            }
+            if (depth == 1) {
+                in_cpus = fdt_str_eq(name, "cpus");
+                in_memory = fdt_str_eq(name, "memory") || fdt_str_prefix(name, "memory@");
+            } else if (depth == 2 && in_cpus) {
+                if (fdt_str_eq(name, "cpu") || fdt_str_prefix(name, "cpu@")) {
+                    (*out_num_cpus)++;
+                }
+            }
+            pos = (end + 4U) & ~3U;
+            depth++;
+        } else if (tok == 2) { /* FDT_END_NODE */
+            depth--;
+            if (depth <= 1) {
+                in_cpus = false;
+                in_memory = false;
+            }
+        } else if (tok == 3) { /* FDT_PROP */
+            if (pos + 8 > totalsize) {
+                break;
+            }
+            uint32_t plen = fdt_be32(b + pos);
+            uint32_t nameoff = fdt_be32(b + pos + 4);
+            pos += 8;
+            if (pos + plen > totalsize || off_strings + nameoff >= totalsize) {
+                break;
+            }
+            const char *pname = (const char *)(b + off_strings + nameoff);
+            if (in_memory && depth == 2 && fdt_str_eq(pname, "reg")) {
+                for (uint32_t off = 0; off + 16 <= plen && *out_num_regs < max_regs; off += 16) {
+                    paddr_t start = (paddr_t)fdt_be64(b + pos + off);
+                    paddr_t size = (paddr_t)fdt_be64(b + pos + off + 8);
+                    if (size == 0 || start > UINTPTR_MAX - size) {
+                        continue;
+                    }
+                    paddr_t end = start + size;
+                    if (start < physBase()) {
+                        start = physBase();
+                    }
+                    if (end > PADDR_TOP) {
+                        end = PADDR_TOP;
+                    }
+                    start = ROUND_UP(start, PAGE_BITS);
+                    end = ROUND_DOWN(end, PAGE_BITS);
+                    if (end > start) {
+                        mem_regs[*out_num_regs].start = start;
+                        mem_regs[*out_num_regs].end = end;
+                        (*out_num_regs)++;
+                    }
+                }
+            }
+            pos = (pos + plen + 3U) & ~3U;
+        } else if (tok == 4) { /* FDT_NOP */
+            continue;
+        } else { /* FDT_END or invalid */
+            break;
+        }
+    }
+    /* Sort mem_regs ascending by start (FDT nodes may be in lexical order, e.g. memory@500000000 before memory@70000000). */
+    for (word_t i = 1; i < *out_num_regs; i++) {
+        p_region_t key = mem_regs[i];
+        word_t j = i;
+        while (j > 0 && mem_regs[j - 1].start > key.start) {
+            mem_regs[j] = mem_regs[j - 1];
+            j--;
+        }
+        mem_regs[j] = key;
+    }
+    /* Merge adjacent/overlapping regions. */
+    if (*out_num_regs > 1) {
+        word_t w = 0;
+        for (word_t i = 1; i < *out_num_regs; i++) {
+            if (mem_regs[i].start <= mem_regs[w].end) {
+                if (mem_regs[i].end > mem_regs[w].end) {
+                    mem_regs[w].end = mem_regs[i].end;
+                }
+            } else {
+                w++;
+                mem_regs[w] = mem_regs[i];
+            }
+        }
+        *out_num_regs = w + 1;
+    }
+}
+#endif
+
 BOOT_CODE static bool_t arch_init_freemem(p_region_t ui_p_reg,
                                           p_region_t dtb_p_reg,
                                           v_region_t it_v_reg,
-                                          word_t extra_bi_size_bits)
