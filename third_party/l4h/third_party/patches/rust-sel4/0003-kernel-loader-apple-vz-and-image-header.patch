@@ -17,7 +17,7 @@ use object::{
 };
 
 use sel4_build_env::{get_libsel4_include_dirs, get_with_sel4_prefix_relative_fallback};
-use sel4_config::{sel4_cfg, sel4_cfg_str};
+use sel4_config::{sel4_cfg, sel4_cfg_bool, sel4_cfg_str};
 
 pub const SEL4_KERNEL_ENV: &str = "SEL4_KERNEL";
 
@@ -40,10 +40,14 @@ fn main() {
             .collect::<Result<Vec<_>, _>>()
             .unwrap();
 
-        cc::Build::new()
+        let mut cc_build = cc::Build::new();
+        cc_build
             .files(&asm_files)
-            .includes(get_libsel4_include_dirs())
-            .compile("asm");
+            .includes(get_libsel4_include_dirs());
+        if sel4_cfg_bool!(PLAT_APPLE_VZ) {
+            cc_build.define("L4H_PLAT_APPLE_VZ", None);
+        }
+        cc_build.compile("asm");
 
         for path in &asm_files {
             println!("cargo::rerun-if-changed={}", path.display());
@@ -60,7 +64,13 @@ fn main() {
     // Note that -Ttext={} is incompatible with --no-rosegment (no error),
     // just bad output. See the "Default program headers" section of:
     // https://maskray.me/blog/2020-12-19-lld-and-gnu-linker-incompatibilities
-    println!("cargo::rustc-link-arg=--image-base=0x{loader_phys_start:x}");
+    if sel4_cfg_bool!(PLAT_APPLE_VZ) {
+        let manifest_dir = std::env::var("CARGO_MANIFEST_DIR").unwrap();
+        println!("cargo::rustc-link-arg=-T{manifest_dir}/link-apple-vz.ld");
+        println!("cargo::rerun-if-changed=link-apple-vz.ld");
+    } else {
+        println!("cargo::rustc-link-arg=--image-base=0x{loader_phys_start:x}");
+    }
 
     println!("cargo::rustc-link-arg=-z");
     println!("cargo::rustc-link-arg=max-page-size=4096");
diff --git a/crates/sel4-kernel-loader/link-apple-vz.ld b/crates/sel4-kernel-loader/link-apple-vz.ld
new file mode 100644
index 0000000..802a93c
--- /dev/null
+++ b/crates/sel4-kernel-loader/link-apple-vz.ld
@@ -0,0 +1,35 @@
+ENTRY(_start)
+
+SECTIONS {
+    . = 0x90000000;
+
+    .text : {
+        KEEP(*(.text.head))
+        *(.text.startup)
+        *(.text .text.*)
+    }
+
+    .rodata : ALIGN(4096) {
+        *(.rodata .rodata.*)
+    }
+
+    .data : ALIGN(4096) {
+        *(.data .data.*)
+        *(.got .got.*)
+    }
+
+    .bss (NOLOAD) : ALIGN(4096) {
+        __bss_start = .;
+        *(.bss .bss.*)
+        *(COMMON)
+    }
+
+    . = ALIGN(4096);
+    _end = .;
+
+    /DISCARD/ : {
+        *(.comment)
+        *(.note.*)
+        *(.eh_frame*)
+    }
+}
diff --git a/crates/sel4-kernel-loader/src/arch/arm/arch/aarch64/mod.rs b/crates/sel4-kernel-loader/src/arch/arm/arch/aarch64/mod.rs
index 27ab6d0..de79914 100644
--- a/crates/sel4-kernel-loader/src/arch/arm/arch/aarch64/mod.rs
+++ b/crates/sel4-kernel-loader/src/arch/arm/arch/aarch64/mod.rs
@@ -62,9 +62,13 @@ impl Arch for ArchImpl {
         let kernel_entry =
             unsafe { mem::transmute::<usize, KernelEntry>(payload_info.kernel_entry.to_usize()) };
 
-        let (dtb_addr_p, dtb_size) = match payload_info.dtb.as_ref() {
-            Some(dtb) => (dtb.addr_p.to_usize(), dtb.size.to_usize()),
-            None => (0, 0),
+        let (dtb_addr_p, dtb_size) = if sel4_config::sel4_cfg_bool!(PLAT_APPLE_VZ) {
+            crate::boot_fdt_region()
+        } else {
+            match payload_info.dtb.as_ref() {
+                Some(dtb) => (dtb.addr_p.to_usize(), dtb.size.to_usize()),
+                None => (0, 0),
+            }
         };
 
         let current_el = get_current_el();
diff --git a/crates/sel4-kernel-loader/src/barrier.rs b/crates/sel4-kernel-loader/src/barrier.rs
index 44c102f..b544c12 100644
--- a/crates/sel4-kernel-loader/src/barrier.rs
+++ b/crates/sel4-kernel-loader/src/barrier.rs
@@ -10,21 +10,26 @@ use core::sync::atomic::{AtomicUsize, Ordering};
 // ::spin::Barrier appears to use too tight of a loop
 
 pub(crate) struct Barrier {
-    num_threads: usize,
+    num_threads: AtomicUsize,
     count: AtomicUsize,
 }
 
 impl Barrier {
     pub(crate) const fn new(n: usize) -> Self {
         Self {
-            num_threads: n,
+            num_threads: AtomicUsize::new(n),
             count: AtomicUsize::new(0),
         }
     }
 
+    pub(crate) fn set_num_threads(&self, n: usize) {
+        self.num_threads.store(n, Ordering::SeqCst);
+    }
+
     pub(crate) fn wait(&self) {
+        let target = self.num_threads.load(Ordering::SeqCst);
         let mut count = self.count.fetch_add(1, Ordering::SeqCst);
-        while count < self.num_threads {
+        while count < target {
             hint::spin_loop();
             count = self.count.load(Ordering::SeqCst);
         }
diff --git a/crates/sel4-kernel-loader/src/main.rs b/crates/sel4-kernel-loader/src/main.rs
index 0964795..392051b 100644
--- a/crates/sel4-kernel-loader/src/main.rs
+++ b/crates/sel4-kernel-loader/src/main.rs
@@ -68,11 +68,13 @@ fn main(per_core: <ArchImpl as Arch>::PerCore) -> ! {
     payload.sanity_check(&PLATFORM_INFO, own_footprint.clone());
 
     log::debug!("Copying payload data");
+    let num_cpus = parse_boot_fdt_cpus();
+    relocate_boot_fdt_above_user_image(payload.info.user_image.ui_p_reg_end.to_usize());
     unsafe {
         payload.copy_data_out();
     }
-
-    for core_id in 1..MAX_NUM_NODES {
+    KERNEL_ENTRY_BARRIER.set_num_threads(num_cpus);
+    for core_id in 1..num_cpus {
         let sp = this_image::stacks::get_secondary_stack_bottom(core_id).ptr() as usize;
         {
             let mut init_info = SECONDARY_CORE_INIT_INFO.write();
@@ -83,7 +85,8 @@ fn main(per_core: <ArchImpl as Arch>::PerCore) -> ! {
             });
         }
         log::debug!("Primary core: starting core {core_id}");
-        PlatImpl::start_secondary_core(core_id, sp);
+        let target_id = if sel4_config::sel4_cfg_bool!(PLAT_APPLE_VZ) { unsafe { BOOT_CPU_MPIDRS[core_id] } } else { core_id };
+        PlatImpl::start_secondary_core(target_id, sp);
         {
             let init_info = SECONDARY_CORE_INIT_INFO.read();
             let init_info = init_info.as_ref().unwrap();
@@ -126,3 +129,127 @@ fn common_epilogue(
     fmt::debug_println_without_synchronization!("Core {}: failed to enter kernel", core_id);
     ArchImpl::idle()
 }
+
+
+#[unsafe(no_mangle)]
+pub(crate) static mut boot_fdt_paddr: usize = 0;
+
+static mut BOOT_FDT_SIZE: usize = 0;
+static mut BOOT_CPU_MPIDRS: [usize; MAX_NUM_NODES] = [0; MAX_NUM_NODES];
+
+pub(crate) fn boot_fdt_region() -> (usize, usize) {
+    unsafe { (boot_fdt_paddr, BOOT_FDT_SIZE) }
+}
+
+fn parse_boot_fdt_cpus() -> usize {
+    for i in 0..MAX_NUM_NODES {
+        unsafe { BOOT_CPU_MPIDRS[i] = i; }
+    }
+    if !sel4_config::sel4_cfg_bool!(PLAT_APPLE_VZ) {
+        return MAX_NUM_NODES;
+    }
+    let paddr = unsafe { boot_fdt_paddr };
+    if paddr == 0 {
+        return MAX_NUM_NODES;
+    }
+    let b = paddr as *const u8;
+    let be32 = |off: usize| -> u32 {
+        unsafe {
+            u32::from_be_bytes([
+                b.add(off).read(),
+                b.add(off + 1).read(),
+                b.add(off + 2).read(),
+                b.add(off + 3).read(),
+            ])
+        }
+    };
+    if be32(0) != 0xd00d_feed {
+        return MAX_NUM_NODES;
+    }
+    let totalsize = be32(4) as usize;
+    let off_struct = be32(8) as usize;
+    let off_strings = be32(12) as usize;
+    if totalsize < 40 || off_struct >= totalsize || off_strings >= totalsize {
+        return MAX_NUM_NODES;
+    }
+    unsafe { BOOT_FDT_SIZE = totalsize; }
+    let mut pos = off_struct;
+    let mut depth = 0i32;
+    let mut in_cpus = false;
+    let mut in_cpu = false;
+    let mut cpus = 0usize;
+    let mut cur_idx = 0usize;
+    while pos + 4 <= totalsize {
+        let tok = be32(pos);
+        pos += 4;
+        match tok {
+            1 => {
+                let start = pos;
+                while pos < totalsize && unsafe { b.add(pos).read() } != 0 {
+                    pos += 1;
+                }
+                if pos >= totalsize { break; }
+                let name = unsafe { core::slice::from_raw_parts(b.add(start), pos - start) };
+                if depth == 1 {
+                    in_cpus = name == b"cpus";
+                } else if depth == 2 && in_cpus && (name == b"cpu" || name.starts_with(b"cpu@")) {
+                    in_cpu = true;
+                    cur_idx = cpus;
+                    cpus += 1;
+                }
+                pos = (pos + 4) & !3;
+                depth += 1;
+            }
+            2 => {
+                depth -= 1;
+                if depth <= 2 { in_cpu = false; }
+                if depth <= 1 { in_cpus = false; }
+            }
+            3 => {
+                if pos + 8 > totalsize { break; }
+                let plen = be32(pos) as usize;
+                let nameoff = be32(pos + 4) as usize;
+                pos += 8;
+                if pos + plen > totalsize || off_strings + nameoff >= totalsize { break; }
+                if in_cpu && cur_idx < MAX_NUM_NODES {
+                    let sstart = off_strings + nameoff;
+                    let mut send = sstart;
+                    while send < totalsize && unsafe { b.add(send).read() } != 0 {
+                        send += 1;
+                    }
+                    let pname = unsafe { core::slice::from_raw_parts(b.add(sstart), send - sstart) };
+                    if pname == b"reg" {
+                        let mpidr = if plen >= 8 {
+                            ((be32(pos) as usize) << 32) | (be32(pos + 4) as usize)
+                        } else if plen >= 4 {
+                            be32(pos) as usize
+                        } else {
+                            cur_idx
+                        };
+                        unsafe { BOOT_CPU_MPIDRS[cur_idx] = mpidr; }
+                    }
+                }
+                pos = (pos + plen + 3) & !3;
+            }
+            4 => {}
+            _ => break,
+        }
+    }
+    if cpus == 0 { MAX_NUM_NODES } else { cpus.min(MAX_NUM_NODES) }
+}
+
+
+fn relocate_boot_fdt_above_user_image(ui_p_reg_end: usize) {
+    if !sel4_config::sel4_cfg_bool!(PLAT_APPLE_VZ) {
+        return;
+    }
+    let (src, size) = unsafe { (boot_fdt_paddr, BOOT_FDT_SIZE) };
+    if src == 0 || size == 0 {
+        return;
+    }
+    let dst = (ui_p_reg_end + 4095) & !4095;
+    unsafe {
+        core::ptr::copy(src as *const u8, dst as *mut u8, size);
+        boot_fdt_paddr = dst;
+    }
+}
