From 5cec1de19ad621b68a69cc96fe73f5dd60536220 Mon Sep 17 00:00:00 2001
From: l4h <l4h@localhost>
Date: Fri, 20 Nov 2026 09:19:09 +0000
Subject: [PATCH] kernel-loader: add apple-vz platform, ARM64 Image header, and
 dynamic FDT CPUs

---
 crates/sel4-kernel-loader/asm/aarch64/head.S  |  70 +++++++++
 crates/sel4-kernel-loader/build.rs            |  20 ++-
 crates/sel4-kernel-loader/link-apple-vz.ld    |  35 +++++
 .../src/arch/arm/arch/aarch64/mod.rs          |  10 +-
 crates/sel4-kernel-loader/src/barrier.rs      |  11 +-
 crates/sel4-kernel-loader/src/main.rs         | 133 +++++++++++++++++-
 .../src/plat/apple_vz/mod.rs                  |  34 +++++
 crates/sel4-kernel-loader/src/plat/mod.rs     |   5 +
 8 files changed, 304 insertions(+), 14 deletions(-)
 create mode 100644 crates/sel4-kernel-loader/link-apple-vz.ld
 create mode 100644 crates/sel4-kernel-loader/src/plat/apple_vz/mod.rs

diff --git a/crates/sel4-kernel-loader/asm/aarch64/head.S b/crates/sel4-kernel-loader/asm/aarch64/head.S
index be277e4..32fce74 100644
--- a/crates/sel4-kernel-loader/asm/aarch64/head.S
+++ b/crates/sel4-kernel-loader/asm/aarch64/head.S
@@ -21,12 +21,77 @@
 .extern invalidate_dcache
 .extern invalidate_icache
 
+#ifdef L4H_PLAT_APPLE_VZ
+.section ".text.head", "ax"
+_start:
+    /* 64-byte ARM64 Linux Image header for Apple VZLinuxBootLoader */
+    b       _apple_vz_entry
+    .word   0
+    .quad   0x20000000          /* text_offset = 512 MiB (0x9000_0000) */
+    .quad   0x08000000          /* image_size = 128 MiB (patched to exact size on pack) */
+    .quad   0x0000000000000002  /* flags: LE, 4K pages, respect text_offset */
+    .quad   0
+    .quad   0
+    .quad   0
+    .ascii  "ARM\x64"
+    .word   0
+
+.section ".text.startup", "ax"
+_apple_vz_entry:
+    mov     x19, x0             /* preserve live FDT paddr from VZLinuxBootLoader */
+    adr     x0, _start          /* actual runtime load address */
+    ldr     x1, =_start         /* linked address (0x9000_0000) */
+    cmp     x0, x1
+    b.eq    _apple_vz_reloc_done
+    ldr     x2, [x0, #16]       /* image_size from header */
+    add     x2, x2, #15
+    and     x2, x2, #~15
+    mov     x7, x2              /* save byte count for D-cache clean */
+    b.hi    _apple_vz_reloc_fwd
+    /* x0 < x1: copy backwards to handle overlap */
+    add     x3, x0, x2
+    add     x4, x1, x2
+1:
+    ldp     x5, x6, [x3, #-16]!
+    stp     x5, x6, [x4, #-16]!
+    subs    x2, x2, #16
+    b.ne    1b
+    b       _apple_vz_reloc_flush
+_apple_vz_reloc_fwd:
+    /* x0 > x1: copy forwards to handle overlap */
+    mov     x3, x0
+    mov     x4, x1
+2:
+    ldp     x5, x6, [x3], #16
+    stp     x5, x6, [x4], #16
+    subs    x2, x2, #16
+    b.ne    2b
+_apple_vz_reloc_flush:
+    mov     x3, x1
+    add     x4, x1, x7
+3:
+    dc      cvau, x3
+    add     x3, x3, #64
+    cmp     x3, x4
+    b.lo    3b
+    dsb     ish
+    ic      iallu
+    dsb     ish
+    isb
+    ldr     x0, =_apple_vz_reloc_done
+    br      x0
+_apple_vz_reloc_done:
+    mrs     x0, mpidr_el1
+    and     x0, x0, #0x00ffffff
+    cbnz    x0, hang
+#else
 .section ".text.startup"
 
 _start:
     mrs     x0, mpidr_el1
     and     x0, x0, #0xf        // Check processor id
     cbnz    x0, hang            // Hang for all non-primary CPU
+#endif
 
     ldr     x0, =__bss_start    // [TODO] GNU LD has __bss_start__ and __bss_end__ which feel more robust
     ldr     x1, =_end
@@ -36,6 +101,11 @@ clear_bss_loop:
     cmp     x0, x1
     b.lt    clear_bss_loop
 
+#ifdef L4H_PLAT_APPLE_VZ
+    ldr     x0, =boot_fdt_paddr
+    str     x19, [x0]
+#endif
+
     ldr     x9, =__primary_stack_bottom
     ldr     x9, [x9]
     mov     sp, x9
diff --git a/crates/sel4-kernel-loader/build.rs b/crates/sel4-kernel-loader/build.rs
index 3d36f22..6ccfb00 100644
--- a/crates/sel4-kernel-loader/build.rs
